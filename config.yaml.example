# Video Intel configuration -- template.
# Copy this file to config.yaml and edit for your own setup.
# config.yaml is gitignored (per-user paths and channel list).

# Where generated artifacts live (mindmaps, transcripts, meta.json, taxonomy.json,
# and by default the LanceDB vector index). Use an absolute path. Cloud-synced
# paths (Google Drive, OneDrive, Dropbox) are fine for text artifacts.
output_dir: ~/video-intel

# vector_db_dir: where the LanceDB vector index lives. Defaults to output_dir/.lancedb.
# IMPORTANT: must be on a real local filesystem. Cloud-synced drives (Google Drive File
# Stream, OneDrive, Dropbox) break LanceDB's MVCC commit with "Incorrect function"
# (os error 1) on Windows. If output_dir is on one of those, uncomment the line below
# and point it at a local cache directory. The index is derived (rebuildable via the
# `index` command), so it is safe to live outside output_dir. See ADR-0016.
# vector_db_dir: ~/.cache/video-intel/lancedb

default_since: 10d
default_prompt: mindmap-knowledge
model: gemini-3-flash-preview
max_parallel: 10
auto_concepts: true

# Issue #42: ceiling on transcript duration. Above this, the structured-JSON
# response truncates beyond what salvage can recover. Mindmap loop is
# unaffected. Default 7200 = 2 hours leaves headroom for typical technical
# talks; raise to 10800 for podcast creators who routinely go to 3h.
transcript_max_duration_seconds: 7200

# Channels to scan. Each channel is a YouTube handle; curate commands (scan, index,
# concepts, etc.) require this list to be populated. Search commands do not.
channels:
  - name: example_creator
    url: https://youtube.com/@example
    auto_transcript: all
    since: 90d
    # skip_shorts is true by default — set false to opt back in for creators
    # whose Shorts (under 60s, or vertical /shorts/ URLs) are substantive.
    # skip_shorts: false
    # Issue #42: declarative pre-fetch blocklist. List YouTube video IDs that
    # scan should never touch (e.g. workshops, conference recordings the user
    # has decided are not worth Gemini cost). Filter applies before any API
    # call. Override = remove the ID from this list.
    # skip_video_ids:
    #   - ABCDEFGHIJK

  # Notify-only mode: long-form podcasts where the user wants to cherry-pick
  # episodes manually rather than auto-process. auto_mindmap=none means scan
  # logs new videos but doesn't run Gemini. min_duration_seconds drops any
  # short clips below the channel-specific definition of "real content".
  - name: example_long_form_podcast
    url: https://youtube.com/@example_podcast
    auto_mindmap: none           # discovery only, zero Gemini cost
    auto_transcript: none
    min_duration_seconds: 1800   # drop anything under 30 min
    since: 90d

  # Selective mode: only pull specific playlists or keyword-matched videos.
  # Useful when a creator posts across many topics and you only want a slice.
  - name: example_selective
    url: https://youtube.com/@anotherexample
    playlists:
      - Some Playlist Name
    keywords:
      - specific topic
    auto_transcript: none

  # One-off creator: not pulled by regular `scan`, but kept in config so
  # `mindmap --url --channel <name>`, `transcript --url --channel <name>`,
  # and `concepts --channel <name>` route artifacts here. Use this when a
  # creator posts occasional gold but you do not want their full feed.
  # Removing `enabled: false` re-enables regular scanning.
  - name: example_oneoff
    url: https://youtube.com/@oneoffcreator
    auto_transcript: all
    enabled: false

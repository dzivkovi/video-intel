# Video Intel configuration -- template.
# Copy this file to config.yaml and edit for your own setup.
# config.yaml is gitignored (per-user paths and channel list).

# Where generated artifacts live (mindmaps, transcripts, meta.json, taxonomy.json,
# and by default the LanceDB vector index). Use an absolute path. Cloud-synced
# paths (Google Drive, OneDrive, Dropbox) are fine for text artifacts.
output_dir: ~/video-intel

# vector_db_dir: where the LanceDB vector index lives. Defaults to output_dir/.lancedb.
# IMPORTANT: must be on a real local filesystem. Cloud-synced drives (Google Drive File
# Stream, OneDrive, Dropbox) break LanceDB's MVCC commit with "Incorrect function"
# (os error 1) on Windows. If output_dir is on one of those, uncomment the line below
# and point it at a local cache directory. The index is derived (rebuildable via the
# `index` command), so it is safe to live outside output_dir. See ADR-0016.
# vector_db_dir: ~/.cache/video-intel/lancedb

default_since: 10d
default_prompt: mindmap-knowledge
# Gemini model for every step. Chosen by measurement, not spec sheet: run
# `python scripts/model_eval.py --candidate <new> --incumbent <current>` and read
# the scorecard in tests/evals/model-cards/ before changing this. The dimension
# that decides it here is timestamped-segment granularity, because that sets the
# precision of the `&t=<seconds>` deep links the corpus exists to produce - not
# throughput, and not the vendor's benchmark table.
model: gemini-3.7-flash

# Optional per-step overrides (transcript / mindmap / concepts). Precedence:
#   --model flag > models.<step> > model > DEFAULT_MODEL
# An explicit --model suppresses this whole block, so the "force Pro when Flash
# struggles" recovery still applies to the entire run. Empty by default.
# models:
#   transcript: <model>
#   mindmap: <model>
#   concepts: <model>

max_parallel: 10
auto_concepts: true

# Issue #42: ceiling on transcript duration. Above this, the structured-JSON
# response truncates beyond what salvage can recover. Mindmap loop is
# unaffected. Default 7200 = 2 hours leaves headroom for typical technical
# talks; raise to 10800 for podcast creators who routinely go to 3h.
transcript_max_duration_seconds: 7200

# How long a video may be before the transcript step splits it into separate
# Gemini calls, in minutes. Density, not duration, predicts an output-cap
# truncation, so a dense 42-minute keynote can truncate where a rambling
# 90-minute interview does not (issue #128). Lower this for conference and
# keynote channels; raise it for conversational ones.
# Default 30. It was 50 until issue #157 measured multi-minute blind gaps at
# that size, so do not raise it back toward 50 without re-checking transcript
# quality flags on the result.
chunk_minutes: 30

# Wall-clock ceiling on a single transcript Gemini call, in seconds (issue #74).
# On expiry the video routes to the captions failover instead of hanging the
# whole scan. Must stay BELOW the HTTP read timeout (1200s) so this fires first.
transcript_timeout_seconds: 600

# Per-channel overrides: every knob in this block can also be set on an
# individual channel below, and the channel value wins. Precedence throughout is
#   CLI flag > per-channel > top-level > built-in default
# That applies to chunk_minutes, transcript_timeout_seconds,
# transcript_max_duration_seconds, skip_shorts, auto_concepts, prompt and since.

# Issue #54: per-channel `mindmap_source: auto|transcript|video|none` controls
# what the mindmap step reads. Default `auto` (no opt-in needed):
#   - `auto`        use transcript when one is on disk; else watch the video.
#                   This is the new (cheaper, faster) default whenever
#                   auto_transcript is also configured to run.
#   - `transcript`  MUST use transcript; ERROR when none is available.
#                   Surfaces the explicit-knob conflict (e.g. with
#                   skip_modes['transcript']) instead of silently falling back.
#   - `video`       legacy path: mindmap watches the video directly
#                   (~10x more expensive, hits Gemini's 10800-frame cap on
#                   3h+ videos).
#   - `none`        no mindmap at all (independent of `auto_mindmap`).
# Configure per-channel under the channels list below.

# Channels to scan. Each channel is a YouTube handle; curate commands (scan, index,
# concepts, etc.) require this list to be populated. Search commands do not.
channels:
  - name: example_creator
    url: https://youtube.com/@example
    auto_transcript: all
    since: 90d
    # transcript_source controls how the transcript step gets its text.
    # Default "gemini" when the key is absent. Set it deliberately:
    #   gemini       Gemini multimodal: speech + on-screen text + diarization.
    #                Richest output, and the only mode that reads slides.
    #   yt-captions  Build from YouTube's public English caption track. Cheap
    #                and fast, but SPEECH ONLY (no screen content, no speaker
    #                labels), and it fails outright when a video has no captions.
    #   auto         Try Gemini; on failure (exception, 403, token cap, or the
    #                confabulation guard tripping) fall back to captions. Never
    #                worse than "gemini", so this is the safe choice for most
    #                channels.
    # One subtlety worth knowing: for a completed-livestream VOD, an ABSENT key
    # and an explicit "auto" both route captions-FIRST, because livestream URIs
    # fail Gemini ingestion at a much higher rate. Writing "gemini" explicitly
    # opts out of that and keeps Gemini first, which is what you want when the
    # captions are known-bad or the on-screen content is the point.
    # transcript_source: auto
    #
    # prompt: override the mind map prompt for this channel only (a name from
    # prompts/, without the .md). Falls back to the top-level default_prompt.
    # Read by `scan` and by the `scan --dry-run` preflight; the manual
    # `mindmap --url` / `process` commands do NOT consult it (issue #216), so
    # pass --prompt on those.
    # prompt: mindmap-heavy
    #
    # Any top-level knob can be overridden here, and the channel value wins:
    # chunk_minutes: 20                  # a dense keynote channel
    # transcript_timeout_seconds: 900    # a slow-to-transcribe channel
    # transcript_max_duration_seconds: 10800
    # auto_concepts: false
    #
    # mindmap_source defaults to "auto" -- transcript-first when available,
    # video fallback when not. Override only when needed:
    # mindmap_source: video       # force legacy mindmap-from-video path
    # mindmap_source: transcript  # error when no transcript exists
    # mindmap_source: none        # skip mindmap entirely
    # skip_shorts is true by default — set false to opt back in for creators
    # whose Shorts (under 60s, or vertical /shorts/ URLs) are substantive.
    # skip_shorts: false
    # Issue #42: declarative pre-fetch blocklist. List YouTube video IDs that
    # scan should never touch (e.g. workshops, conference recordings the user
    # has decided are not worth Gemini cost). Filter applies before any API
    # call. Override = remove the ID from this list.
    # skip_video_ids:
    #   - ABCDEFGHIJK

  # Notify-only mode: long-form podcasts where the user wants to cherry-pick
  # episodes manually rather than auto-process. auto_mindmap=none means scan
  # logs new videos but doesn't run Gemini. min_duration_seconds drops any
  # short clips below the channel-specific definition of "real content".
  - name: example_long_form_podcast
    url: https://youtube.com/@example_podcast
    auto_mindmap: none           # discovery only, zero Gemini cost
    auto_transcript: none
    min_duration_seconds: 1800   # drop anything under 30 min
    since: 90d

  # Selective mode: only pull specific playlists or keyword-matched videos.
  # Useful when a creator posts across many topics and you only want a slice.
  - name: example_selective
    url: https://youtube.com/@anotherexample
    playlists:
      - Some Playlist Name
    keywords:
      - specific topic
    auto_transcript: none

  # One-off creator: not pulled by regular `scan`, but kept in config so
  # `mindmap --url --channel <name>`, `transcript --url --channel <name>`,
  # and `concepts --channel <name>` route artifacts here. Use this when a
  # creator posts occasional gold but you do not want their full feed.
  # Removing `enabled: false` re-enables regular scanning.
  - name: example_oneoff
    url: https://youtube.com/@oneoffcreator
    auto_transcript: all
    enabled: false

  # Peripheral vision: a YouTube creator you do NOT actively follow, but whose
  # new uploads you want glanced at as "Other headlines" at the end of a full
  # `scan` (like flipping a newspaper for a catchy title worth a manual look).
  # `enabled: false` keeps it out of the primary Gemini pipeline; the separate
  # `headline_digest: true` opt-in surfaces its latest uploads metadata-only -
  # NO mindmap/transcript/concepts, NO corpus artifacts. Ranked by title match
  # against _briefings/profile.yaml; a bounded _headlines/seen.json means a
  # given upload is shown once, not every run. Requires a real YouTube url/id.
  - name: example_headlines
    url: https://youtube.com/@peripheralcreator
    enabled: false
    headline_digest: true

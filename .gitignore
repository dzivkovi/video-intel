.env*
!.env.example
*.skill
consolidated_chat*.md

# Local config.yaml is per-user (paths, channels). Copy config.yaml.example to
# config.yaml and edit. See CLAUDE.md for the user-level install procedure.
/config.yaml
print/
research/
work/
plans/*.md
!plans/.gitkeep
.claude/settings.local.json
/video-intel/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.venv/
venv/
.coverage

# DeepEval local caches — must not be committed, contain developer fingerprint
.deepeval/
.deepeval*
temp_test_run_data.json

# Per-run eval JSONL diagnostics — regenerated on every `pytest tests/evals/` run
tests/evals/results/

examples/*.part-*.txt
examples/*.txt.tmp

# Manual post-processing of translate-bcs outputs (e.g. .fixed.txt) is
# private to the author and never committed. The raw .translate-bcs.txt
# and .en.srt outputs ARE tracked as before/after evidence.
examples/*.fixed.txt

# Isolated LanceDB output from the real-Voyage validation harness; binary
# artifacts. Harness is reproducible from the committed source.
examples/.lancedb-validation/

.codex-review-smoke2/
.codex-review-smoke2-out/

.claude/scheduled_tasks.lock

# Compound Engineering local config — example.yaml is committed, *.local.yaml is not
.compound-engineering/*.local.yaml
.context/

# Skill eval workspace — default-exclude, allow signal-bearing artifacts.
# See skill-eval-workspace/README.md for the lifecycle convention.
skill-eval-workspace/**
!skill-eval-workspace/**/
!skill-eval-workspace/**/*-report.html
!skill-eval-workspace/**/*-trigger-eval.json
!skill-eval-workspace/README.md
# Windows-safe trigger-eval runner (the upstream run_eval.py fails on Windows:
# select.select on a pipe -> WinError 10038, anthropics/skills#1061). Reusable tool.
!skill-eval-workspace/*.py

# Local smoke-test sandboxes (Gate 1 evidence is committed under docs/plans/gate1-evidence)
/.smoke/
/.firecrawl/
/tv-stitch-*/
.codex/config.toml
.worktrees
.playwright-mcp/

# Raw Gemini responses cached by scripts/model_eval.py. Regenerable and bulky;
# the committed evidence is the scorecard (.md/.json), not the raw payloads.
tests/evals/model-cards/_raw/

# Real A/B fixtures point at videos from the maintainer's private corpus and
# annotate each with the defect it exposes - a curated-watchlist extract.
# The committed template is model_fixtures.yaml.example (mirrors config.yaml).
tests/evals/model_fixtures.yaml

# Gate 1 harness scratch output (can contain corpus copies)
gate1_*_out/

# Reader-facing renders of examples stay on disk, never in git (2026-09-02)
examples/*.docx
examples/*.pdf

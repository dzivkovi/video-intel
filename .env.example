# Copy this file to `.env` and adjust values. `.env` is gitignored; this
# `.env.example` template IS committed to help others install.
#
# Load these into your shell before launching Claude Code so the ${VAR}
# references in `.mcp.json` resolve:
#   set -a && source .env && set +a
# (or add the exports to your ~/.bashrc for persistence)

# --- Neo4j (local Docker, GDS-enabled) for the intelligence-layer graph work ---
# LOCALHOST-ONLY dev credentials for a container bound to 127.0.0.1. This is an
# intentional local development password, NOT a real secret - nothing outside
# this machine can reach the database. Safe to commit as an install template.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=Sup3rSecur3!  # gitleaks:allow - intentional localhost dev password, not a secret
NEO4J_DATABASE=neo4j
